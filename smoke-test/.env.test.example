# Base URL of the running integrations backend. Do not include a trailing slash.
BASE_URL=http://localhost:3000

# Internal API key for the backend under test. `npm run smoke` reads it from the root .env, so leave
# this commented out locally. Uncomment it only to target another server. Never commit a real value.
# INTERNAL_API_KEY=

# Optional staff actor header value (email). Avoid real personal data in shared reports.
ACTOR_EMAIL=test-staff@example.invalid

# Optional: set a known test Planning Center person ID to enable a profile read.
# Use an authorized test record only; profile responses may contain contact details.
TEST_PERSON_ID=

# Optional: set a known service type ID to test plan listing.
TEST_SERVICE_TYPE_ID=

# Optional: set true to call POST /v1/integrations/planning-center/test-read.
# This reads the connected Planning Center user's own profile; it does not write data.
ENABLE_PCO_SELF_TEST=false
