# Copy to .env (git-ignored) and fill in locally. NEVER commit real values.
# In production, set these in the hosting platform's secret manager instead of a file.

NODE_ENV=development
PORT=3000
# Public base URL of THIS service. The OAuth callback is derived from it:
#   ${PUBLIC_BASE_URL}/v1/integrations/planning-center/callback
PUBLIC_BASE_URL=http://localhost:3000

# SQLite file for local development (git-ignored).
DATABASE_PATH=./data/integrations.db

# Organization this single-tenant deployment serves.
DEFAULT_ORG_SLUG=cityhope
DEFAULT_ORG_NAME=City Hope Church

# Shared key the ministrytask backend (or you, during testing) sends in the
# X-Api-Key header. Generate with: openssl rand -base64 48
INTERNAL_API_KEY=replace-with-a-long-random-value

# 32-byte AES-256-GCM key for encrypting provider tokens at rest.
# Generate with: npm run gen:key
# Keep this OUT of the database and its backups.
TOKEN_ENCRYPTION_KEY=replace-with-base64-32-bytes
TOKEN_ENCRYPTION_KEY_ID=k1
# During key rotation only: the previous key, so old ciphertexts still decrypt.
TOKEN_ENCRYPTION_KEY_PREVIOUS=
TOKEN_ENCRYPTION_KEY_PREVIOUS_ID=

# Planning Center OAuth application (api.planningcenteronline.com > Developer > OAuth applications)
PCO_CLIENT_ID=replace-me
PCO_CLIENT_SECRET=replace-me
# Planning Center requires an identifying User-Agent on every request.
PCO_USER_AGENT=ministrytask integrations (rvanvarden@cityhope.cc)
# Optional safety lock: the Planning Center organization ID that may be connected.
# Leave blank for the first connection; fill it in afterwards (shown by the status endpoint).
PCO_EXPECTED_ORGANIZATION_ID=
