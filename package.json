{
  "name": "ministrytask-integrations",
  "version": "0.1.0",
  "description": "Integration service for ministrytask: Planning Center (People, Services, Groups); ClickUp and Google Calendar later.",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env --import tsx src/server.ts",
    "migrate": "tsx --env-file=.env src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronnievv/MinistryTast_backendCalls.git"
  },
  "bugs": {
    "url": "https://github.com/ronnievv/MinistryTast_backendCalls/issues"
  },
  "homepage": "https://github.com/ronnievv/MinistryTast_backendCalls#readme",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "kysely": "^0.29.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "pino": "^10.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
